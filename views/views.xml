<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <menuitem id="menu_g1_bank_root"
                  name="G1 Bank"
                  sequence="10"/>

        <record id="action_g1_customer" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">tree,form</field>
        </record>


        <record id="action_g1_account" model="ir.actions.act_window">
            <field name="name">Accounts</field>
            <field name="res_model">g1.account</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_g1_movement" model="ir.actions.act_window">
            <field name="name">Movements</field>
            <field name="res_model">g1.movement</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_g1_customers"
                  name="Customers"
                  parent="menu_g1_bank_root"
                  action="action_g1_customer"
                  sequence="15"/>

        <menuitem id="menu_g1_accounts"
                  name="Accounts"
                  parent="menu_g1_bank_root"
                  action="action_g1_account"
                  sequence="20"/>

        <menuitem id="menu_g1_movements"
                  name="Movements"
                  parent="menu_g1_bank_root"
                  action="action_g1_movement"
                  sequence="30"/>

        <record id="g1_account_tree" model="ir.ui.view">
            <field name="name">g1.account.tree</field>
            <field name="model">g1.account</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="account_type"/>
                    <field name="begin_balance"/>
                    <field name="credit_line"/>
                    <field name="opening_date"/>
                    <field name="balance"/>
                </tree>
            </field>
        </record>

        <record id="g1_movement_tree" model="ir.ui.view">
            <field name="name">g1.movement.tree</field>
            <field name="model">g1.movement</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="amount"/>
                    <field name="balance"/>
                    <field name="timestamp"/>
                </tree>
            </field>
        </record>

        <record id="customer_tree_view" model="ir.ui.view">
            <field name="name">g1_bank.customer.tree</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <field name="lang" position="replace">
                    <field name="city"/>
                </field>
                <field name="login_date" position="replace">
                    <field name="phone"/>
                </field>
                <field name="phone" position="after">
                    <field name="zip"/>
                    <field name="street"/>
                    <field name="state_id"/>
                </field>
            </field>
        </record>


        <record id="customer_form_view" model="ir.ui.view">
            <field name="name">g1_bank.customer.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_simple_form"/>
            <field name="arch" type="xml">
                <group name="phone_numbers" position="replace">
                    <group>
                        <group>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cuentas" name="detalles_cuentas">
                            <field name="account_ids"/>
                        </page>
                    </notebook>
                </group>
            </field>
        </record>

        <record id="customer_search_view" model="ir.ui.view">
            <field name="name">g1_bank.customer.search</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_search"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="city" string="Ciudad"/>
                    <field name="zip" string="Codigo Postal"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
